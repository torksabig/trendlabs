# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# local worker database (snapshot JSON is committed for Vercel)
data/*.db
data/*.db-journal
!data/snapshots/
!public/data/

# Backtest / walk-forward run dumps (keep latest for dashboard)
data/backtests/*
!data/backtests/.gitkeep
!data/backtests/latest.json
data/walk_forward/*
!data/walk_forward/.gitkeep
!data/walk_forward/latest.json
