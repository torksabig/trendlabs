# Optional Alpaca Basic credentials (free tier). Without these, Yahoo Finance is used.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_FEED=iex

# Optional Supabase (apply supabase/migrations/*.sql)
# Workers must use the service role / secret key — never expose it in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local research LLM on your Mac (Ollama). Never used for trade execution.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b-q4_K_M

# Simulation controls
STARTING_CASH=10000
MAX_POSITIONS=3
RISK_PER_TRADE=0.01
FEE_BPS=5
SLIPPAGE_BPS=5
DEFAULT_TIMEFRAME=1h
LOOKBACK_BARS=400
