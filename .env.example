# Optional Alpaca Basic credentials (free tier). Without these, Yahoo Finance is used.
# Used by: python -m trendlabs.extract / collect
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_FEED=iex

# Optional local paths for extraction / worker DB
# TRENDLAB_DATA_DIR=
# TRENDLAB_DB=
# LOOKBACK_BARS=400          # short collect window; extract uses timeframe max history

# Optional Supabase (apply supabase/migrations/*.sql)
# Workers must use the service role / secret key — never expose it in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Research LLM — never used for trade execution.
# Provider: auto | google | groq | openrouter | cloudflare | cerebras | mistral | ollama | fallback
# auto tries free-cloud keys in order, then Ollama, then rule-based fallback.
TRENDLAB_LLM_PROVIDER=auto

# Local Ollama (Mac)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b-q4_K_M

# Free-tier cloud providers (set any one for Vercel / Actions research)
# GOOGLE_AI_API_KEY=                 # or GEMINI_API_KEY=
# GOOGLE_AI_MODEL=gemini-2.0-flash
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama3.1-8b
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# Optional: Python used by TrendLab Arena sidebar job buttons (local Next.js)
# TRENDLAB_PYTHON=/absolute/path/to/.venv/bin/python
# TRENDLAB_ALLOW_JOBS=1
# TRENDLAB_JOB_MODE=local            # force local spawn even if GitHub env is set
# TRENDLAB_JOB_MODE=github_actions   # force Actions dispatch

# Vercel / production: Arena buttons dispatch .github/workflows/trendlabs.yml
# Use a fine-grained PAT (or classic) with actions:write + contents:write.
# Never set NEXT_PUBLIC_ on these — server-only.
# GITHUB_TOKEN=
# GH_JOB_TOKEN=                      # alias for GITHUB_TOKEN if the platform reserves that name
# GITHUB_REPOSITORY=torksabig/trendlabs
# GITHUB_REF=main                    # optional branch/ref for workflow_dispatch


# Simulation controls
STARTING_CASH=10000
MAX_POSITIONS=3
RISK_PER_TRADE=0.01
FEE_BPS=5
SLIPPAGE_BPS=5
DEFAULT_TIMEFRAME=1h
LOOKBACK_BARS=400
