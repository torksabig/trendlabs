# Optional Alpaca Basic credentials (free tier). Without these, Yahoo Finance is used.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_FEED=iex

# Optional Supabase (apply supabase/migrations/001_trendlabs_schema.sql)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Simulation controls
STARTING_CASH=10000
MAX_POSITIONS=3
RISK_PER_TRADE=0.01
FEE_BPS=5
SLIPPAGE_BPS=5
DEFAULT_TIMEFRAME=1h
LOOKBACK_BARS=400
